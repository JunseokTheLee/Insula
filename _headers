# Cache policy — see SEO_DEPLOYMENT_CHECKLIST.md for the full rationale.
# HTML is never cached without revalidation, so a deploy is visible
# immediately instead of Safari/search-engine caches holding an old page.
# Cloudflare Pages already defaults static HTML responses to
# `public, max-age=0, must-revalidate` (functionally equivalent — always
# revalidates); these make that policy explicit for every real, extension-
# less page URL on the site rather than relying on the platform default.
# (Each pattern needs its own repeated header lines below it — Cloudflare's
# _headers format doesn't let multiple patterns share one block.)
/
  Cache-Control: no-cache
/en/
  Cache-Control: no-cache
/ko/
  Cache-Control: no-cache
/en/about
  Cache-Control: no-cache
/en/network
  Cache-Control: no-cache
/en/privacy
  Cache-Control: no-cache
/en/disclaimer
  Cache-Control: no-cache
/en/campaigns
  Cache-Control: no-cache
/en/admin
  Cache-Control: no-cache
/ko/about
  Cache-Control: no-cache
/ko/network
  Cache-Control: no-cache
/ko/privacy
  Cache-Control: no-cache
/ko/disclaimer
  Cache-Control: no-cache
/ko/campaigns
  Cache-Control: no-cache
/ko/admin
  Cache-Control: no-cache

# CSS/JS are safe to cache for a year: every page links them with a
# ?v=<timestamp> query that tools/bump-asset-version.js re-stamps whenever a
# JS/CSS file changes (the pre-commit hook in tools/git-hooks does it). A new
# deploy therefore uses new URLs, so caches fetch the new files immediately
# and never mix an old script with a new one. (Before 2026-09-09 this was a
# 1-hour revalidated cache, and the custom domain's Cloudflare setting
# stretched it to 4 hours — every JS deploy took that long to show up.)
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

/logo.png
  Cache-Control: public, max-age=86400
/logo-96.png
  Cache-Control: public, max-age=86400
/logo.ico
  Cache-Control: public, max-age=86400

# Security headers applied to every response. `x-content-type-options` and
# `referrer-policy` are already set at the Cloudflare edge, so they're not
# repeated here to avoid emitting them twice. Content-Security-Policy is
# deliberately left out for now — it needs an allowlist drawn up for the
# external CDNs the site loads (jsdelivr, Google Fonts, Fontshare) first.
/*
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/sitemap-static.xml
  Cache-Control: public, max-age=3600
